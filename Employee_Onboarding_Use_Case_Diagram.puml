@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

title Employee Onboarding Intelligence MVP - Use Case Diagram

actor "New Employee" as Employee
actor "Admin" as Admin
actor "Ollama / Qwen2.5" as LLM

rectangle "Employee Onboarding Intelligence MVP" {
  usecase "Login Using\nEmployee ID" as UC_Login
  usecase "View Personalized\nOnboarding Dashboard" as UC_Dashboard
  usecase "Access Modules /\nCourses" as UC_Modules
  usecase "Complete Module" as UC_Complete
  usecase "View Onboarding\nProgress" as UC_Progress
  usecase "Ask AI Assistant\nQuestion" as UC_AskAI

  usecase "Validate Employee ID" as UC_Validate
  usecase "Load Employee Profile" as UC_Profile
  usecase "Generate Role-Based\nRoadmap" as UC_Roadmap
  usecase "Generate Module & Course\nRecommendations" as UC_Recommendations
  usecase "Update Progress" as UC_UpdateProgress
  usecase "Store Progress in\nDatabase" as UC_StoreProgress
  usecase "Mark Onboarding as\nCompleted" as UC_CompleteOnboarding
  usecase "Retrieve Relevant\nOnboarding Documents" as UC_RetrieveDocs
  usecase "Generate AI Answer" as UC_GenerateAnswer

  usecase "Login to Admin\nDashboard" as UC_AdminLogin
  usecase "Manage Employees" as UC_ManageEmployees
  usecase "Manage Modules &\nCourses" as UC_ManageModules
  usecase "View Onboarding\nOverview" as UC_ViewOverview
  usecase "Monitor Employee\nProgress" as UC_MonitorProgress
}

Employee --> UC_Login
Employee --> UC_Dashboard
Employee --> UC_Modules
Employee --> UC_Complete
Employee --> UC_Progress
Employee --> UC_AskAI

Admin --> UC_AdminLogin
Admin --> UC_ManageEmployees
Admin --> UC_ManageModules
Admin --> UC_ViewOverview
Admin --> UC_MonitorProgress

LLM --> UC_GenerateAnswer

UC_Login .> UC_Validate : <<include>>
UC_Login .> UC_Profile : <<include>>
UC_Login .> UC_Roadmap : <<include>>
UC_Login .> UC_Recommendations : <<include>>

UC_Complete .> UC_UpdateProgress : <<include>>
UC_UpdateProgress .> UC_StoreProgress : <<include>>
UC_UpdateProgress .> UC_CompleteOnboarding : <<extend>>

UC_AskAI .> UC_RetrieveDocs : <<include>>
UC_AskAI .> UC_GenerateAnswer : <<include>>

UC_Dashboard .> UC_Progress : <<include>>
UC_ViewOverview .> UC_MonitorProgress : <<include>>
@enduml
